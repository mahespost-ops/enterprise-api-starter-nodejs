/**
 * Integration Tests: Webhooks Endpoints
 * Phase 2 Batch 5 - TDD RED Phase
 *
 * Tests for:
 * - GET /api/v1/orgs/{orgId}/envs/{envId}/webhooks - List webhooks
 * - POST /api/v1/orgs/{orgId}/envs/{envId}/webhooks - Create webhook
 * - GET /api/v1/orgs/{orgId}/envs/{envId}/webhooks/{webhookId} - Get webhook
 * - PUT /api/v1/orgs/{orgId}/envs/{envId}/webhooks/{webhookId} - Update webhook
 * - DELETE /api/v1/orgs/{orgId}/envs/{envId}/webhooks/{webhookId} - Delete webhook
 * - GET /api/v1/orgs/{orgId}/envs/{envId}/webhooks/{webhookId}/deliveries - List deliveries
 * - GET /api/v1/orgs/{orgId}/envs/{envId}/webhooks/{webhookId}/deliveries/{deliveryId} - Get delivery
 * - POST /api/v1/orgs/{orgId}/envs/{envId}/webhooks/{webhookId}/deliveries/{deliveryId}/retry - Retry delivery
 */

// Mock uuid to avoid ESM issues in Jest
jest.mock('uuid', () => ({
  v4: (): string => 'test-uuid-' + Math.random().toString(36).substring(7),
}));
import request from 'supertest';
import { type Application } from 'express';
import appPromise from '../../app';
import { User } from '../../models/User.model';
import { Organization } from '../../models/Organization.model';
import { Environment } from '../../models/Environment.model';
import { OrganizationMember } from '../../models/OrganizationMember.model';
import { Webhook } from '../../models/Webhook.model';
import { WebhookDelivery } from '../../models/WebhookDelivery.model';
import { Event } from '../../models/Event.model';
import { generateTestJWT, grantPermissions, clearAllPermissions } from '../helpers/auth.helpers';
import { TEST_UUIDS } from '../helpers/test-constants';
import { HTTP_STATUS } from '../../constants/http-status.constants';

describe('Webhooks API Integration Tests', () => {
  let app: Application;
  let testUser: User;
  let testOrg: Organization;
  let testEnv: Environment;
  let testWebhook1: Webhook;
  let testEvent: Event;
  let testDelivery1: WebhookDelivery;
  let testDelivery2: WebhookDelivery;
  let authToken: string;

  beforeAll(async () => {
    // Resolve app promise
    app = await appPromise;
  });

  beforeEach(async () => {
    // Generate unique identifiers for this test run
    const uniqueId = `${Date.now()}-${Math.random().toString(36).substring(7)}`;
    const testEmail = `webhook-test-${uniqueId}@example.com`;
    const testSlug = `test-org-webhook-${uniqueId}`;

    // Create test user
    testUser = await User.create({
      email: testEmail,
      givenName: 'Webhook',
      familyName: 'Test User',
      emailVerified: true,
      isActive: true,
      lastOrgId: null,
      lastEnvId: null,
    });

    // Create test organization
    testOrg = await Organization.create({
      name: 'Test Organization',
      slug: testSlug,
      description: 'Test organization for webhook tests',
      defaultEnvId: null,
      isActive: true,
    });

    // Create test environment
    testEnv = await Environment.create({
      organizationId: testOrg.id,
      name: 'Live',
      description: 'Production environment',
      type: 'live',
      isDefault: true,
      isActive: true,
    });

    // Update organization default environment
    await testOrg.update({ defaultEnvId: testEnv.id });

    // Create organization membership
    await OrganizationMember.create({
      userId: testUser.id,
      organizationId: testOrg.id,
      status: 'active',
      joinedAt: new Date(),
    });

    // Update user's last org/env
    await testUser.update({
      lastOrgId: testOrg.id,
      lastEnvId: testEnv.id,
    });

    // Create test webhooks
    testWebhook1 = await Webhook.create({
      environmentId: testEnv.id,
      name: 'User Events Webhook',
      url: 'https://api.example.com/webhooks/user-events',
      eventTypes: ['auth.login', 'auth.logout', 'user.updated'],
      authMethod: 'hmac',
      authConfig: { secret: 'test-secret-key-16-chars' },
      retryConfig: {
        maxAttempts: 3,
        backoffMultiplier: 2,
        maxBackoffSeconds: 3600,
      },
      isActive: true,
      failureCount: 0,
      lastSuccessAt: new Date('2025-10-04T10:00:00Z'),
      lastFailureAt: null,
      metadata: { description: 'Notifies external system of user events' },
    });

    await Webhook.create({
      environmentId: testEnv.id,
      name: 'Device Events Webhook',
      url: 'https://api.example.com/webhooks/device-events',
      eventTypes: ['device.created', 'device.revoked'],
      authMethod: 'none',
      authConfig: null,
      retryConfig: {
        maxAttempts: 5,
        backoffMultiplier: 2,
        maxBackoffSeconds: 7200,
      },
      isActive: false,
      failureCount: 3,
      lastSuccessAt: null,
      lastFailureAt: new Date('2025-10-04T09:00:00Z'),
      metadata: null,
    });

    // Create test event for delivery tests
    testEvent = await Event.create({
      environmentId: testEnv.id,
      organizationId: testOrg.id,
      organizationName: testOrg.name,
      environmentName: testEnv.name,
      verb: 'auth.login',
      actorType: 'User',
      actor: {
        type: 'User',
        id: testUser.id,
        name: testUser.fullName,
        email: testUser.email,
      },
      object: {
        type: 'Session',
        id: TEST_UUIDS.SESSION_ACTIVE,
      },
      target: null,
      audit: null,
      description: 'User logged in',
      timestamp: new Date('2025-10-04T12:00:00Z'),
      isWebhookEvent: true,
    });

    // Create test deliveries
    testDelivery1 = await WebhookDelivery.create({
      webhookId: testWebhook1.id,
      eventId: testEvent.id,
      status: 'success',
      attempt: 1,
      httpStatusCode: 200,
      requestPayload: {
        specversion: '1.0',
        type: 'auth.login',
        source: `/orgs/${testOrg.id}/envs/${testEnv.id}`,
        id: testEvent.id,
        time: testEvent.timestamp.toISOString(),
        data: testEvent.object,
      },
      responseBody: '{"status":"ok"}',
      errorMessage: null,
      scheduledFor: new Date('2025-10-04T12:00:00Z'),
      sentAt: new Date('2025-10-04T12:00:01Z'),
      completedAt: new Date('2025-10-04T12:00:02Z'),
      nextRetryAt: null,
    });

    testDelivery2 = await WebhookDelivery.create({
      webhookId: testWebhook1.id,
      eventId: testEvent.id,
      status: 'failed',
      attempt: 3,
      httpStatusCode: 500,
      requestPayload: {
        specversion: '1.0',
        type: 'auth.login',
        source: `/orgs/${testOrg.id}/envs/${testEnv.id}`,
        id: testEvent.id,
        time: testEvent.timestamp.toISOString(),
        data: testEvent.object,
      },
      responseBody: 'Internal Server Error',
      errorMessage: 'HTTP 500: Internal Server Error',
      scheduledFor: new Date('2025-10-04T11:00:00Z'),
      sentAt: new Date('2025-10-04T11:00:01Z'),
      completedAt: new Date('2025-10-04T11:00:02Z'),
      nextRetryAt: null,
    });

    // Grant permissions to test user
    await grantPermissions(testUser.id, ['webhooks:read', 'webhooks:manage']);

    // Generate auth token
    authToken = generateTestJWT({
      sub: testUser.id,
      orgId: testOrg.id,
      envId: testEnv.id,
      user: {
        email: testUser.email,
        fullName: testUser.fullName,
      },
    });
  });

  afterEach(async () => {
    // Clean up in reverse order of foreign key dependencies
    await clearAllPermissions();
    await WebhookDelivery.destroy({ where: {}, force: true });
    await Event.destroy({ where: {}, force: true });
    await Webhook.destroy({ where: {}, force: true });
    await OrganizationMember.destroy({ where: {}, force: true });
    await Environment.destroy({ where: {}, force: true });
    // Clean up test organizations only (exclude system org)
    const SYSTEM_ORG_ID = '00000000-0000-0000-0000-000000000001';
    await Organization.destroy({ where: { id: { [require('sequelize').Op.ne]: SYSTEM_ORG_ID } }, force: true });
    await User.destroy({ where: {}, force: true });
  });

  afterAll(async () => {
    const { sequelize } = await import('../../models');
    await sequelize.close();
  });

  /**
   * GET /api/v1/orgs/{orgId}/envs/{envId}/webhooks
   */
  describe('GET /api/v1/orgs/:orgId/envs/:envId/webhooks - List webhooks', () => {
    it('should list all webhooks for environment (200)', async () => {
      const res = await request(app)
        .get(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.OK);
      expect(res.body).toHaveProperty('data');
      expect(res.body).toHaveProperty('pagination');
      expect(Array.isArray(res.body.data)).toBe(true);
      expect(res.body.data.length).toBe(2);

      // Verify webhook structure (should NOT include authConfig in list view)
      const webhook = res.body.data[0];
      expect(webhook).toHaveProperty('id');
      expect(webhook).toHaveProperty('name');
      expect(webhook).toHaveProperty('url');
      expect(webhook).toHaveProperty('eventTypes');
      expect(webhook).toHaveProperty('isActive');
      expect(webhook).not.toHaveProperty('authConfig'); // Security: masked in list view
    });

    it('should return 401 when not authenticated', async () => {
      const res = await request(app)
        .get(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks`);

      expect(res.status).toBe(HTTP_STATUS.UNAUTHORIZED);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 403 when user lacks permission', async () => {
      // Revoke permission
      await clearAllPermissions();

      const res = await request(app)
        .get(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.FORBIDDEN);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 422 when envId is invalid UUID', async () => {
      const res = await request(app)
        .get(`/api/v1/orgs/${testOrg.id}/envs/invalid-uuid/webhooks`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.UNPROCESSABLE_ENTITY);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 500 when database error occurs', async () => {
      // Mock Webhook.findAll to throw error
      const mockFindAll = jest.spyOn(Webhook, 'findAll').mockRejectedValue(new Error('Database error'));

      const res = await request(app)
        .get(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.INTERNAL_SERVER_ERROR);
      expect(res.body).toHaveProperty('message');

      mockFindAll.mockRestore();
    });
  });

  /**
   * POST /api/v1/orgs/{orgId}/envs/{envId}/webhooks
   */
  describe('POST /api/v1/orgs/:orgId/envs/:envId/webhooks - Create webhook', () => {
    it('should create webhook successfully (201)', async () => {
      const newWebhook = {
        name: 'New Webhook',
        url: 'https://api.example.com/webhooks/new',
        eventTypes: ['user.created', 'user.deleted'],
        authMethod: 'jwt',
        authConfig: { secret: 'jwt-secret-key-16-chars' },
        retryConfig: {
          maxAttempts: 5,
          backoffMultiplier: 2,
          maxBackoffSeconds: 3600,
        },
        isActive: true,
      };

      const res = await request(app)
        .post(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks`)
        .set('Authorization', `Bearer ${authToken}`)
        .send(newWebhook);

      expect(res.status).toBe(HTTP_STATUS.CREATED);
      expect(res.body).toMatchObject({
        name: newWebhook.name,
        url: newWebhook.url,
        eventTypes: newWebhook.eventTypes,
        authMethod: newWebhook.authMethod,
        isActive: true,
      });
      expect(res.body).toHaveProperty('id');
      expect(res.body).toHaveProperty('createdAt');
    });

    it('should return 401 when not authenticated', async () => {
      const res = await request(app)
        .post(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks`)
        .send({ name: 'Test', url: 'https://example.com' });

      expect(res.status).toBe(HTTP_STATUS.UNAUTHORIZED);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 403 when user lacks webhooks:manage permission', async () => {
      // Grant only read permission
      await clearAllPermissions();
      await grantPermissions(testUser.id, ['webhooks:read']);

      const res = await request(app)
        .post(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks`)
        .set('Authorization', `Bearer ${authToken}`)
        .send({ name: 'Test', url: 'https://example.com', eventTypes: [] });

      expect(res.status).toBe(HTTP_STATUS.FORBIDDEN);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 422 when required fields are missing', async () => {
      const res = await request(app)
        .post(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks`)
        .set('Authorization', `Bearer ${authToken}`)
        .send({ name: 'Incomplete Webhook' });

      expect(res.status).toBe(HTTP_STATUS.UNPROCESSABLE_ENTITY);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 500 when database error occurs', async () => {
      // Mock Webhook.create to throw error
      const mockCreate = jest.spyOn(Webhook, 'create').mockRejectedValue(new Error('Database error'));

      const res = await request(app)
        .post(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks`)
        .set('Authorization', `Bearer ${authToken}`)
        .send({
          name: 'Test',
          url: 'https://example.com/webhook',
          eventTypes: ['user.created'],
          authMethod: 'none'
        });

      expect(res.status).toBe(HTTP_STATUS.INTERNAL_SERVER_ERROR);
      expect(res.body).toHaveProperty('message');

      mockCreate.mockRestore();
    });
  });

  /**
   * GET /api/v1/orgs/{orgId}/envs/{envId}/webhooks/{webhookId}
   */
  describe('GET /api/v1/orgs/:orgId/envs/:envId/webhooks/:webhookId - Get webhook', () => {
    it('should retrieve webhook details (200)', async () => {
      const res = await request(app)
        .get(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.OK);
      expect(res.body).toMatchObject({
        id: testWebhook1.id,
        name: testWebhook1.name,
        url: testWebhook1.url,
        eventTypes: testWebhook1.eventTypes,
        authMethod: testWebhook1.authMethod,
        isActive: testWebhook1.isActive,
      });
      expect(res.body).not.toHaveProperty('authConfig'); // Security: always masked
    });

    it('should return 401 when not authenticated', async () => {
      const res = await request(app)
        .get(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}`);

      expect(res.status).toBe(HTTP_STATUS.UNAUTHORIZED);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 403 when user lacks permission', async () => {
      await clearAllPermissions();

      const res = await request(app)
        .get(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.FORBIDDEN);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 404 when webhook does not exist', async () => {
      const res = await request(app)
        .get(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${TEST_UUIDS.NONEXISTENT}`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.NOT_FOUND);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 422 when webhookId is invalid UUID', async () => {
      const res = await request(app)
        .get(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/invalid-uuid`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.UNPROCESSABLE_ENTITY);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 500 when database error occurs', async () => {
      const mockFindByPk = jest.spyOn(Webhook, 'findByPk').mockRejectedValue(new Error('Database error'));

      const res = await request(app)
        .get(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.INTERNAL_SERVER_ERROR);
      expect(res.body).toHaveProperty('message');

      mockFindByPk.mockRestore();
    });
  });

  /**
   * PUT /api/v1/orgs/{orgId}/envs/{envId}/webhooks/{webhookId}
   */
  describe('PUT /api/v1/orgs/:orgId/envs/:envId/webhooks/:webhookId - Update webhook', () => {
    it('should update webhook successfully (200)', async () => {
      const updates = {
        name: 'Updated Webhook Name',
        isActive: false,
      };

      const res = await request(app)
        .put(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}`)
        .set('Authorization', `Bearer ${authToken}`)
        .send(updates);

      expect(res.status).toBe(HTTP_STATUS.OK);
      expect(res.body.name).toBe(updates.name);
      expect(res.body.isActive).toBe(updates.isActive);
    });

    it('should return 401 when not authenticated', async () => {
      const res = await request(app)
        .put(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}`)
        .send({ name: 'Updated' });

      expect(res.status).toBe(HTTP_STATUS.UNAUTHORIZED);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 403 when user lacks webhooks:manage permission', async () => {
      await clearAllPermissions();
      await grantPermissions(testUser.id, ['webhooks:read']);

      const res = await request(app)
        .put(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}`)
        .set('Authorization', `Bearer ${authToken}`)
        .send({ name: 'Updated' });

      expect(res.status).toBe(HTTP_STATUS.FORBIDDEN);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 404 when webhook does not exist', async () => {
      const res = await request(app)
        .put(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${TEST_UUIDS.NONEXISTENT}`)
        .set('Authorization', `Bearer ${authToken}`)
        .send({ name: 'Updated' });

      expect(res.status).toBe(HTTP_STATUS.NOT_FOUND);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 422 when validation fails', async () => {
      const res = await request(app)
        .put(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}`)
        .set('Authorization', `Bearer ${authToken}`)
        .send({ url: 'not-a-valid-url' });

      expect(res.status).toBe(HTTP_STATUS.UNPROCESSABLE_ENTITY);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 500 when database error occurs', async () => {
      const mockSave = jest.spyOn(Webhook.prototype, 'save').mockRejectedValue(new Error('Database error'));

      const res = await request(app)
        .put(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}`)
        .set('Authorization', `Bearer ${authToken}`)
        .send({ name: 'Updated' });

      expect(res.status).toBe(HTTP_STATUS.INTERNAL_SERVER_ERROR);
      expect(res.body).toHaveProperty('message');

      mockSave.mockRestore();
    });
  });

  /**
   * DELETE /api/v1/orgs/{orgId}/envs/{envId}/webhooks/{webhookId}
   */
  describe('DELETE /api/v1/orgs/:orgId/envs/:envId/webhooks/:webhookId - Delete webhook', () => {
    it('should delete webhook successfully (204)', async () => {
      const res = await request(app)
        .delete(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.NO_CONTENT);
      expect(res.body).toEqual({});

      // Verify webhook is soft-deleted
      const deleted = await Webhook.findByPk(testWebhook1.id, { paranoid: false });
      expect(deleted?.deletedAt).not.toBeNull();
    });

    it('should return 401 when not authenticated', async () => {
      const res = await request(app)
        .delete(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}`);

      expect(res.status).toBe(HTTP_STATUS.UNAUTHORIZED);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 403 when user lacks webhooks:manage permission', async () => {
      await clearAllPermissions();
      await grantPermissions(testUser.id, ['webhooks:read']);

      const res = await request(app)
        .delete(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.FORBIDDEN);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 404 when webhook does not exist', async () => {
      const res = await request(app)
        .delete(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${TEST_UUIDS.NONEXISTENT}`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.NOT_FOUND);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 422 when webhookId is invalid UUID', async () => {
      const res = await request(app)
        .delete(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/invalid-uuid`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.UNPROCESSABLE_ENTITY);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 500 when database error occurs', async () => {
      const mockDestroy = jest.spyOn(Webhook.prototype, 'destroy').mockRejectedValue(new Error('Database error'));

      const res = await request(app)
        .delete(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.INTERNAL_SERVER_ERROR);
      expect(res.body).toHaveProperty('message');

      mockDestroy.mockRestore();
    });
  });

  /**
   * GET /api/v1/orgs/{orgId}/envs/{envId}/webhooks/{webhookId}/deliveries
   */
  describe('GET /api/v1/orgs/:orgId/envs/:envId/webhooks/:webhookId/deliveries - List deliveries', () => {
    it('should list webhook deliveries (200)', async () => {
      const res = await request(app)
        .get(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}/deliveries`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.OK);
      expect(res.body).toHaveProperty('data');
      expect(res.body).toHaveProperty('pagination');
      expect(Array.isArray(res.body.data)).toBe(true);
      expect(res.body.data.length).toBe(2);

      // Verify delivery structure
      const delivery = res.body.data[0];
      expect(delivery).toHaveProperty('id');
      expect(delivery).toHaveProperty('status');
      expect(delivery).toHaveProperty('attempt');
      expect(delivery).toHaveProperty('httpStatusCode');
    });

    it('should return 401 when not authenticated', async () => {
      const res = await request(app)
        .get(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}/deliveries`);

      expect(res.status).toBe(HTTP_STATUS.UNAUTHORIZED);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 403 when user lacks permission', async () => {
      await clearAllPermissions();

      const res = await request(app)
        .get(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}/deliveries`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.FORBIDDEN);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 404 when webhook does not exist', async () => {
      const res = await request(app)
        .get(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${TEST_UUIDS.NONEXISTENT}/deliveries`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.NOT_FOUND);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 422 when webhookId is invalid UUID', async () => {
      const res = await request(app)
        .get(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/invalid-uuid/deliveries`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.UNPROCESSABLE_ENTITY);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 500 when database error occurs', async () => {
      const mockFindAndCountAll = jest.spyOn(WebhookDelivery, 'findAndCountAll').mockRejectedValue(new Error('Database error'));

      const res = await request(app)
        .get(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}/deliveries`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.INTERNAL_SERVER_ERROR);
      expect(res.body).toHaveProperty('message');

      mockFindAndCountAll.mockRestore();
    });
  });

  /**
   * GET /api/v1/orgs/{orgId}/envs/{envId}/webhooks/{webhookId}/deliveries/{deliveryId}
   */
  describe('GET /api/v1/orgs/:orgId/envs/:envId/webhooks/:webhookId/deliveries/:deliveryId - Get delivery', () => {
    it('should retrieve delivery details (200)', async () => {
      const res = await request(app)
        .get(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}/deliveries/${testDelivery1.id}`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.OK);
      expect(res.body).toMatchObject({
        id: testDelivery1.id,
        webhookId: testWebhook1.id,
        eventId: testEvent.id,
        status: 'success',
        attempt: 1,
        httpStatusCode: 200,
      });
      expect(res.body).toHaveProperty('requestPayload');
      expect(res.body).toHaveProperty('responseBody');
    });

    it('should return 401 when not authenticated', async () => {
      const res = await request(app)
        .get(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}/deliveries/${testDelivery1.id}`);

      expect(res.status).toBe(HTTP_STATUS.UNAUTHORIZED);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 403 when user lacks permission', async () => {
      await clearAllPermissions();

      const res = await request(app)
        .get(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}/deliveries/${testDelivery1.id}`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.FORBIDDEN);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 404 when delivery does not exist', async () => {
      const res = await request(app)
        .get(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}/deliveries/${TEST_UUIDS.NONEXISTENT}`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.NOT_FOUND);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 422 when deliveryId is invalid UUID', async () => {
      const res = await request(app)
        .get(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}/deliveries/invalid-uuid`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.UNPROCESSABLE_ENTITY);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 500 when database error occurs', async () => {
      const mockFindByPk = jest.spyOn(WebhookDelivery, 'findByPk').mockRejectedValue(new Error('Database error'));

      const res = await request(app)
        .get(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}/deliveries/${testDelivery1.id}`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.INTERNAL_SERVER_ERROR);
      expect(res.body).toHaveProperty('message');

      mockFindByPk.mockRestore();
    });
  });

  /**
   * POST /api/v1/orgs/{orgId}/envs/{envId}/webhooks/{webhookId}/deliveries/{deliveryId}/retry
   */
  describe('POST /api/v1/orgs/:orgId/envs/:envId/webhooks/:webhookId/deliveries/:deliveryId/retry - Retry delivery', () => {
    it('should retry failed delivery (202)', async () => {
      const res = await request(app)
        .post(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}/deliveries/${testDelivery2.id}/retry`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.ACCEPTED);
      expect(res.body).toHaveProperty('message');
      expect(res.body.message).toContain('scheduled for retry');
    });

    it('should return 401 when not authenticated', async () => {
      const res = await request(app)
        .post(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}/deliveries/${testDelivery2.id}/retry`);

      expect(res.status).toBe(HTTP_STATUS.UNAUTHORIZED);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 403 when user lacks webhooks:manage permission', async () => {
      await clearAllPermissions();
      await grantPermissions(testUser.id, ['webhooks:read']);

      const res = await request(app)
        .post(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}/deliveries/${testDelivery2.id}/retry`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.FORBIDDEN);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 404 when delivery does not exist', async () => {
      const res = await request(app)
        .post(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}/deliveries/${TEST_UUIDS.NONEXISTENT}/retry`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.NOT_FOUND);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 422 when deliveryId is invalid UUID', async () => {
      const res = await request(app)
        .post(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}/deliveries/invalid-uuid/retry`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.UNPROCESSABLE_ENTITY);
      expect(res.body).toHaveProperty('message');
    });

    it('should return 500 when database error occurs', async () => {
      const mockFindByPk = jest.spyOn(WebhookDelivery, 'findByPk').mockRejectedValue(new Error('Database error'));

      const res = await request(app)
        .post(`/api/v1/orgs/${testOrg.id}/envs/${testEnv.id}/webhooks/${testWebhook1.id}/deliveries/${testDelivery2.id}/retry`)
        .set('Authorization', `Bearer ${authToken}`);

      expect(res.status).toBe(HTTP_STATUS.INTERNAL_SERVER_ERROR);
      expect(res.body).toHaveProperty('message');

      mockFindByPk.mockRestore();
    });
  });
